# --- Database ---
# Local dev uses SQLite (zero setup). Production (Vercel + Supabase) never
# reads this file: the deployed app gets DATABASE_URL from Vercel, and
# `npm run build` flips the Prisma provider automatically when that URL is
# postgres://. Commands run from this laptop against production use
# PROD_DATABASE_URL below.
DATABASE_URL="file:./dev.db"

# --- Production database (Supabase Postgres) ---
# Used only by the db:*:prod scripts — never by the dev server or the tests.
# Supabase → Project Settings → Database → Connection string → "Session
# pooler" (port 5432). Looks like:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
PROD_DATABASE_URL=""

# --- App ---
# Public base URL, used to build personalised reminder links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Collection window (SAST calendar dates, inclusive).
COLLECTION_START_DATE="2026-10-01"
COLLECTION_END_DATE="2026-10-31"

# --- Reminders: email (Agent 3) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="HSA Data Collection <noreply@example.org>"

# --- Reminders: WhatsApp (Agent 3) ---
# Meta WhatsApp Cloud API. Leave blank to fall back to email only.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAME="hsa_daily_log_reminder"

# --- Ops ---
# Shared secret the external ping bot / cron trigger must present.
CRON_SECRET="change-me-in-production"

# --- Researcher access (temporary) ---
# Shared code for POST /api/auth/researcher, the development stopgap that lets
# the HSA research team into /dashboard before per-researcher accounts exist.
# In production the route refuses to run unless this is set; in development it
# falls back to "hsa-dev-researcher". Create the account itself with
# `npm run db:researcher`.
RESEARCHER_CODE=""

# --- Google sign-in (Better Auth) ---
# Optional. Leave blank and the "Continue with Google" button simply does not
# appear — the app falls back to the personalised reminder link, exactly as
# before. Create the credentials at https://console.cloud.google.com/apis/credentials
# → "Create credentials" → "OAuth client ID" → "Web application".
#
# The authorised redirect URI must be EXACTLY (matching NEXT_PUBLIC_APP_URL):
#   http://localhost:3000/api/oauth/callback/google
# Note /api/oauth, not /api/auth: this app's own auth routes already own
# /api/auth/*, so Better Auth is mounted one prefix over.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Signs the OAuth state. Generate with: openssl rand -base64 32
# In production, Google sign-in stays switched off until this is set — a
# well-known fallback secret would be worse than no Google sign-in at all.
BETTER_AUTH_SECRET=""
# Usually leave blank. NEXT_PUBLIC_APP_URL is inlined at BUILD time like every
# NEXT_PUBLIC_ variable, so if a host only supplies it at runtime the Google
# redirect would point at whatever was baked in. This one is read at runtime
# and overrides it. Set it to the public origin, no trailing slash.
BETTER_AUTH_URL=""
