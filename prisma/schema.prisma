// HSA Patient Data Collection — shared database schema.
//
// OWNERSHIP: integration lead. The three build streams have been merged, so
// this is now edited in one place rather than read-only — but a change here
// still ripples through the contract, the API, the form and the export, and
// tests/backend/helpers/schema.sql must be regenerated to match.
//
// POPIA: there is deliberately no patient-identifying column anywhere below.
// Data is recorded per *patient* but never per *person*: a PatientEntry says
// only that somebody, new or returning, was seen, and a ConditionEntry records
// what was treated — never who. Nothing links the same individual across two
// days. Practitioner.email is the only personal datum in the system and must
// never leave the server in any dashboard/export response — use
// Practitioner.id as the anonymised key.
//
// Enum-like columns are plain String because SQLite has no native enum type.
// The permitted values live in src/lib/contract/enums.ts and are enforced by
// Zod at every API boundary. Keep the two in sync.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  // SQLite for local dev so every agent can run the app with zero setup.
  // Production (Vercel + Supabase) runs on Postgres: scripts/build.mjs flips
  // this provider to "postgresql" for the deployed build, and
  // scripts/with-prod-db.mjs does the same for the db:*:prod laptop
  // commands — both restore "sqlite" afterwards. The flip must precede
  // `prisma generate`, because the generated client is provider-flavoured.
  // No SQLite-only features are used. The connection URL lives in
  // prisma.config.ts (Prisma 7 driver adapters).
  provider = "sqlite"
}

/// A homeopathic practitioner taking part in the October 2026 collection.
/// `id` is the anonymised identifier used in every dashboard and export.
model Practitioner {
  id           String  @id @default(cuid())
  email        String  @unique
  fullName     String
  practiceName String?
  province     String?

  /// Unguessable id embedded in personalised reminder links. Authenticates a
  /// practitioner arriving on a new device or with cleared storage (FR1).
  reminderLinkId String @unique @default(cuid())

  /// Self-declared consent: signing up *is* the consent event (User story 1.6).
  consentAt   DateTime  @default(now())
  /// Set the first time the practitioner completes onboarding (FR2).
  onboardedAt DateTime?

  /// PRACTITIONER | RESEARCHER — gates the researcher dashboard.
  role String @default("PRACTITIONER")

  // --- Reminder preferences (FR7) ---
  /// NONE | EMAIL
  reminderChannel    String    @default("NONE")
  /// "HH:mm" in SAST (Africa/Johannesburg). Default 18:00.
  reminderTime       String    @default("18:00")
  reminderIncludeSat Boolean   @default(false)
  /// When they last opted in to email reminders (null while channel is NONE).
  reminderOptInAt    DateTime?
  /// When the practitioner first answered the reminder question (FR7) — email
  /// or none. Null means they have not been asked yet, so the app shows the
  /// one-off choice screen; once set it is never re-asked, whichever way they
  /// answered. Distinguishes "chose no reminders" from "never asked".
  reminderChoiceAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions   Session[]
  dailyLogs  DailyLog[]
  dispatches ReminderDispatch[]
  overrides  DayOverride[]

  @@index([reminderChannel])
}

/// On-device session so a practitioner never re-enters their email (FR1).
model Session {
  id String @id @default(cuid())

  /// SHA-256 of the bearer token. The raw token is returned once at signup
  /// and never stored, so a database leak cannot be replayed as a login.
  tokenHash String @unique

  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([practitionerId])
  @@index([expiresAt])
}

/// One row per practitioner per calendar day (FR3).
model DailyLog {
  id String @id @default(cuid())

  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  /// SAST calendar date as "yyyy-MM-dd". Stored as a string on purpose: a
  /// DateTime would be UTC-normalised, and an 18:00 SAST log would land on the
  /// previous UTC day, silently corrupting daily counts and reminder logic.
  logDate String

  newPatients      Int @default(0)
  followUpPatients Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patients PatientEntry[]

  @@unique([practitionerId, logDate])
  @@index([logDate])
}

/// One patient seen on a given day. Conditions hang off a patient rather than
/// off the day, so the dataset can answer "how many patients presented with
/// more than one condition?" and "were new patients more likely to be
/// GP-referred?" — questions the day-level model could not express at all.
///
/// POPIA: there is still nothing identifying here, by construction. A
/// PatientEntry says only "somebody, new or returning, was seen" — no name, no
/// age, no sex, no file number, and no key that links the same person across
/// two days. The rows are patient-*scoped*, not patient-*identified*.
model PatientEntry {
  id String @id @default(cuid())

  dailyLogId String
  dailyLog   DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  /// NEW | FOLLOW_UP — see enums.ts
  patientType String

  /// 1-based position within its type on that day. Gives the form a stable
  /// order to render and re-load in; it carries no identity and is not
  /// comparable across days.
  position Int

  createdAt DateTime @default(now())

  conditions ConditionEntry[]

  @@index([dailyLogId])
  @@index([patientType])
}

/// A condition treated for one patient (FR4/FR5/FR6). One row per condition
/// per patient: a patient presenting with both anxiety and insomnia is two
/// rows sharing a `patientEntryId`.
model ConditionEntry {
  id String @id @default(cuid())

  patientEntryId String
  patientEntry   PatientEntry @relation(fields: [patientEntryId], references: [id], onDelete: Cascade)

  /// ConditionCategory code — see enums.ts
  category String
  /// Condition.code from the taxonomy table, or "OTHER" for free text.
  conditionCode String
  /// Free text, only when conditionCode == "OTHER". Never clinical notes.
  conditionOther String?

  /// CLINICAL_DIAGNOSIS | PATIENT_REPORTED_PRIOR | PRESENTING_COMPLAINT_ONLY
  diagnosisBasis String @default("CLINICAL_DIAGNOSIS")
  /// YES | NO | UNSURE — "also seeing a GP for this?"
  alsoSeeingGp String @default("UNSURE")
  /// YES | NO | NOT_APPLICABLE — "referred by a GP?"
  referredByGp String @default("NOT_APPLICABLE")

  createdAt DateTime @default(now())

  @@index([patientEntryId])
  @@index([category])
  @@index([conditionCode])
  @@index([alsoSeeingGp])
}

/// The condition taxonomy, held in the database rather than in code so the
/// research team can extend the list during October without a redeploy
/// (rubric item 5, tier 3). Seeded from src/lib/contract/taxonomy.ts.
model Condition {
  code     String @id
  category String
  label    String

  /// Pipe-separated search aliases, e.g. "TB|Mycobacterium|consumption".
  synonyms String @default("")
  /// Typeahead ordering — lower sorts first, so common conditions lead.
  rank     Int     @default(100)
  isActive Boolean @default(true)

  @@index([category])
  @@index([isActive])
}

/// "Mark done for today" / snooze. Lets a practitioner suppress a reminder on a
/// day they saw no patients, without fabricating a DailyLog row (FR7).
model DayOverride {
  id String @id @default(cuid())

  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  /// SAST "yyyy-MM-dd", same convention as DailyLog.logDate.
  logDate String

  markedDoneAt DateTime?
  snoozedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([practitionerId, logDate])
}

/// Audit trail of reminder sends. The unique constraint is what guarantees a
/// practitioner is never messaged twice for the same day on the same channel.
model ReminderDispatch {
  id String @id @default(cuid())

  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  /// The SAST "yyyy-MM-dd" this reminder is for.
  logDate String
  /// EMAIL
  channel String
  /// PENDING | SENT | FAILED | SKIPPED
  status String @default("PENDING")
  /// ALREADY_LOGGED | MARKED_DONE | SNOOZED | NOT_OPTED_IN | NON_WORKING_DAY
  skipReason String?
  error      String?

  scheduledFor DateTime
  sentAt       DateTime?
  createdAt    DateTime @default(now())

  @@unique([practitionerId, logDate, channel])
  @@index([logDate])
  @@index([status])
}

/* ------------------------------------------------------------------ *
 * Google sign-in (Better Auth)
 *
 * These four tables are Better Auth's own storage, kept deliberately
 * separate from `Practitioner`/`Session` above. Better Auth answers one
 * question only — "has Google confirmed this person owns this email
 * address?" — and the app's own session is minted from the answer. That
 * keeps the study's model of a participant (a consenting Practitioner
 * with a reminder link) unchanged, and means the Google integration can
 * be switched off by removing two env vars without touching a row of
 * research data.
 *
 * The `Auth` prefix avoids colliding with the existing `Session` model.
 * Better Auth is pointed at these via `modelName` in
 * src/lib/server/googleAuth.ts, which must use the camelCase Prisma client
 * accessor (`authUser`, not `AuthUser`) because the adapter looks the model
 * up as `db[modelName]`.
 *
 * POPIA: nothing here is patient data. It is the practitioner's own
 * Google profile, and like Practitioner.email it must never appear in a
 * dashboard response or an export.
 * ------------------------------------------------------------------ */

/// A verified Google identity. Linked to a Practitioner by email at
/// sign-in time — there is deliberately no foreign key, so an identity
/// that has not signed up yet is simply an identity with no participant.
model AuthUser {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  sessions AuthSession[]
  accounts AuthAccount[]

  @@map("auth_user")
}

/// Better Auth's short-lived session. Not the app's session: this one only
/// carries the caller from the Google redirect to the handoff route.
model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([userId])
  @@map("auth_session")
}

/// The link between an AuthUser and the provider that vouched for them.
model AuthAccount {
  id         String @id @default(cuid())
  accountId  String
  providerId String

  userId String
  user   AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Unused: password sign-in is not enabled. Better Auth's schema requires
  /// the column, so it is present and always null.
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([userId])
  @@map("auth_account")
}

/// OAuth state and one-time values. Rows are short-lived and self-expiring.
model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([identifier])
  @@map("auth_verification")
}
